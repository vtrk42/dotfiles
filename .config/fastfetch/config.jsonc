{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/rukia.png",
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
        "break",
        {
            "type": "title",
            "keyWidth": 10,
            "color": {
              "user": "black",
              "at": "white",
              "host": "black"
            }

        },
        {
            "type": "os",
            "format": "{name}",
            "key": " ",
            "keyColor": "32"  // = color7
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "packages",
            
            "key": " ",
            "keyColor": "34"  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "35" 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "31" 
        },
        {
            "type": "de",
            "key": " ",
            "keyColor": "37" 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "36" 
        },
    
        "break",
        "break",
        "break"
    ]
}
